   "source": [
    "# 🏥 Diagnostic Médical IA — BioMedLM Fine-tuning\n",
    "### Notebook 2 : Fine-tuning avec QLoRA\n",
    "\n",
    "**Ce notebook :**\n",
    "- Charge BioMedLM (Stanford) — modèle spécialisé en biomédecine\n",
    "- Applique QLoRA (quantisation 4-bit + LoRA) pour entraînement sur GPU T4\n",
    "- Lance l'entraînement supervisé\n",
    "- Sauvegarde le modèle fine-tuné\n",
    "\n",
    "> ⏱️ Durée estimée : 30-45 min sur Google Colab T4"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 1 — Vérification GPU\n",
    "# ============================================================\n",
    "import torch\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    gpu_name = torch.cuda.get_device_name(0)\n",
    "    vram = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "    print(f'✅ GPU détecté : {gpu_name}')\n",
    "    print(f'   VRAM disponible : {vram:.1f} GB')\n",
    "else:\n",
    "    print('❌ Pas de GPU — Activez-le via : Exécution → Modifier le type d\\'exécution → GPU')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 2 — Imports\n",
    "# ============================================================\n",
    "import torch\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from transformers import (\n",
    "    AutoTokenizer,\n",
    "    AutoModelForCausalLM,\n",
    "    TrainingArguments,\n",
    "    BitsAndBytesConfig\n",
    ")\n",
    "from peft import (\n",
    "    LoraConfig,\n",
    "    get_peft_model,\n",
    "    TaskType,\n",
    "    prepare_model_for_kbit_training\n",
    ")\n",
    "from trl import SFTTrainer\n",
    "from datasets import load_from_disk\n",
    "\n",
    "print('✅ Imports OK')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 3 — Configuration QLoRA (optimisé Colab T4)\n",
    "# ============================================================\n",
    "\n",
    "# ── Quantisation 4-bit (réduit VRAM de ~70%) ──\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type='nf4',\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_use_double_quant=True,  # Double quantisation pour économiser encore plus\n",
    ")\n",
    "\n",
    "# ── Configuration LoRA ──\n",
    "lora_config = LoraConfig(\n",
    "    task_type=TaskType.CAUSAL_LM,\n",
    "    r=16,              # Rang LoRA (8-32 selon VRAM)\n",
    "    lora_alpha=32,     # Alpha = 2 * r est une bonne règle\n",
    "    target_modules=[   # Modules à adapter\n",
    "        'q_proj', 'v_proj', 'k_proj', 'o_proj',\n",
    "        'gate_proj', 'up_proj', 'down_proj'\n",
    "    ],\n",
    "    lora_dropout=0.05,\n",
    "    bias='none',\n",
    "    inference_mode=False\n",
    ")\n",
    "\n",
    "print('✅ Configuration QLoRA prête')\n",
    "print(f'   Rang LoRA     : {lora_config.r}')\n",
    "print(f'   Quantisation  : 4-bit NF4')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 4 — Chargement de BioMedLM\n",
    "# Modèle : stanford-crfm/BioMedLM (2.7B paramètres)\n",
    "# Spécialisé sur PubMed + littérature médicale\n",
    "# ============================================================\n",
    "\n",
    "MODEL_ID = 'stanford-crfm/BioMedLM'\n",
    "\n",
    "print(f'⏳ Chargement du tokenizer {MODEL_ID}...')\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_ID, trust_remote_code=True)\n",
    "\n",
    "# Tokens spéciaux nécessaires\n",
    "if tokenizer.pad_token is None:\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "tokenizer.padding_side = 'right'\n",
    "\n",
    "print(f'⏳ Chargement du modèle (4-bit)... (peut prendre 2-3 minutes)')\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    MODEL_ID,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map='auto',\n",
    "    trust_remote_code=True\n",
    ")\n",
    "\n",
    "# Préparation pour l'entraînement en 4-bit\n",
    "model = prepare_model_for_kbit_training(model)\n",
    "\n",
    "# Application de LoRA\n",
    "model = get_peft_model(model, lora_config)\n",
    "\n",
    "# Statistiques du modèle\n",
    "total_params = sum(p.numel() for p in model.parameters())\n",
    "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "print(f'\\n✅ Modèle chargé avec LoRA !')\n",
    "print(f'   Paramètres totaux     : {total_params:,}')\n",
    "print(f'   Paramètres entraînables: {trainable_params:,} ({100*trainable_params/total_params:.2f}%)')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 5 — Chargement du dataset\n",
    "# ============================================================\n",
    "dataset = load_from_disk('/content/medical_ai/data/medical_dataset')\n",
    "print(f'✅ Dataset chargé :')\n",
    "print(f'   Train      : {len(dataset[\"train\"])} exemples')\n",
    "print(f'   Validation : {len(dataset[\"validation\"])} exemples')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 6 — Configuration de l'entraînement\n",
    "# Optimisé pour Colab T4 (16GB VRAM)\n",
    "# ============================================================\n",
    "\n",
    "training_args = TrainingArguments(\n",
    "    output_dir='/content/medical_ai/checkpoints',\n",
    "    \n",
    "    # ── Hyperparamètres ──\n",
    "    num_train_epochs=3,\n",
    "    per_device_train_batch_size=2,       # Réduit pour T4\n",
    "    per_device_eval_batch_size=2,\n",
    "    gradient_accumulation_steps=8,       # Simule batch_size=16\n",
    "    learning_rate=2e-4,                  # Recommandé pour QLoRA\n",
    "    weight_decay=0.01,\n",
    "    max_grad_norm=0.3,\n",
    "    \n",
    "    # ── Scheduler ──\n",
    "    lr_scheduler_type='cosine',\n",
    "    warmup_ratio=0.05,\n",
    "    \n",
    "    # ── Optimisation mémoire ──\n",
    "    fp16=True,\n",
    "    optim='paged_adamw_8bit',            # Optimiseur 8-bit économe en VRAM\n",
    "    gradient_checkpointing=True,\n",
    "    \n",
    "    # ── Logging & évaluation ──\n",
    "    logging_steps=10,\n",
    "    eval_strategy='steps',\n",
    "    eval_steps=50,\n",
    "    save_strategy='steps',\n",
    "    save_steps=100,\n",
    "    save_total_limit=2,\n",
    "    load_best_model_at_end=True,\n",
    "    \n",
    "    # ── Divers ──\n",
    "    report_to='none',                    # Désactiver wandb pour simplifier\n",
    "    dataloader_pin_memory=False\n",
    ")\n",
    "\n",
    "print('✅ Arguments d\\'entraînement configurés')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 7 — Lancement de l'entraînement SFT\n",
    "# SFT = Supervised Fine-Tuning\n",
    "# ============================================================\n",
    "\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    tokenizer=tokenizer,\n",
    "    args=training_args,\n",
    "    train_dataset=dataset['train'],\n",
    "    eval_dataset=dataset['validation'],\n",
    "    dataset_text_field='text',           # La colonne contenant le texte formaté\n",
    "    max_seq_length=1024,                 # Longueur max des séquences\n",
    "    packing=False\n",
    ")\n",
    "\n",
    "print('🚀 Démarrage de l\\'entraînement...')\n",
    "print('   (Environ 30-45 minutes sur T4)')\n",
    "print()\n",
    "\n",
    "train_result = trainer.train()\n",
    "\n",
    "print(f'\\n✅ Entraînement terminé !')\n",
    "print(f'   Loss finale    : {train_result.training_loss:.4f}')\n",
    "print(f'   Étapes totales : {train_result.global_step}')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 8 — Sauvegarde du modèle fine-tuné\n",
    "# ============================================================\n",
    "\n",
    "SAVE_PATH = '/content/medical_ai/model_finetuned'\n",
    "\n",
    "trainer.save_model(SAVE_PATH)\n",
    "tokenizer.save_pretrained(SAVE_PATH)\n",
    "\n",
    "print(f'✅ Modèle sauvegardé dans : {SAVE_PATH}')\n",
    "\n",
    "# Sauvegarde sur Google Drive (si déjà monté)\n",
    "import shutil\n",
    "try:\n",
    "    shutil.copytree(SAVE_PATH, '/content/drive/MyDrive/medical_ai_project/model_finetuned', dirs_exist_ok=True)\n",
    "    print('✅ Modèle sauvegardé sur Google Drive !')\n",
    "except Exception as e:\n",
    "    print('⚠️ Drive non monté ou erreur :', e)\n",
    "    print('   Montez Drive (Notebook 1) ou enregistrez sur le Hub (voir ENTRAINEMENT_CLOUD.md).')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# CELLULE 9 — Graphique des métriques d'entraînement\n",
    "# ============================================================\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "logs = trainer.state.log_history\n",
    "train_loss = [(e['step'], e['loss']) for e in logs if 'loss' in e and 'eval_loss' not in e]\n",
    "eval_loss  = [(e['step'], e['eval_loss']) for e in logs if 'eval_loss' in e]\n",
    "\n",
    "plt.figure(figsize=(12, 4))\n",
    "\n",
    "plt.subplot(1, 2, 1)\n",
    "if train_loss:\n",
    "    steps, losses = zip(*train_loss)\n",
    "    plt.plot(steps, losses, 'b-', linewidth=2, label='Train Loss')\n",
    "    plt.xlabel('Étapes'); plt.ylabel('Loss')\n",
    "    plt.title('Training Loss'); plt.legend(); plt.grid(True, alpha=0.3)\n",
    "\n",
    "plt.subplot(1, 2, 2)\n",
    "if eval_loss:\n",
    "    steps, losses = zip(*eval_loss)\n",
    "    plt.plot(steps, losses, 'r-', linewidth=2, label='Eval Loss')\n",
    "    plt.xlabel('Étapes'); plt.ylabel('Loss')\n",
    "    plt.title('Validation Loss'); plt.legend(); plt.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('/content/medical_ai/training_curves.png', dpi=150)\n",
    "plt.show()\n",
    "print('✅ Courbes d\\'entraînement sauvegardées')"
   ],
   "execution_count": null,
   "outputs": []
  }
 ]
}"
